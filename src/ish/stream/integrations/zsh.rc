# ish-stream-api: 1
if (( _ish_stream_zdot_set )); then
    ZDOTDIR=$_ish_stream_zdot
else
    builtin unset ZDOTDIR
fi
if [[ -r "${ZDOTDIR-$HOME}/.zshrc" ]]; then
    builtin source -- "${ZDOTDIR-$HOME}/.zshrc"
fi
_ish_stream_rc_status=$?
function _ish_stream_setup {
    builtin setopt localoptions no_aliases
    builtin source -- @SCRIPT@
}
_ish_stream_setup
builtin unfunction _ish_stream_setup
_ish_stream_return "$_ish_stream_rc_status"
