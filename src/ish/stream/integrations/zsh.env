# ish-stream-api: 1
if (( @ZDOT_SET@ )); then
    ZDOTDIR=@ZDOTDIR@
else
    builtin unset ZDOTDIR
fi
if [[ -r "${ZDOTDIR-$HOME}/.zshenv" ]]; then
    builtin source -- "${ZDOTDIR-$HOME}/.zshenv"
fi
_ish_stream_env_status=$?
_ish_stream_zdot_set=${+ZDOTDIR}
_ish_stream_zdot=${ZDOTDIR-}
ZDOTDIR=@PRIVATE@
function _ish_stream_return { return "$1"; }
_ish_stream_return "$_ish_stream_env_status"
